# Copia este archivo como .env y llena los valores de tu proyecto de Supabase
# (Dashboard > Project Settings > API). El archivo .env NO se sube a git.

# URL del proyecto, ej. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Llave pública "anon" (o la nueva "publishable"). Es segura en el navegador
# porque los permisos reales los controlan las políticas RLS.
VITE_SUPABASE_ANON_KEY=

# (Opcional) Dirección pública de la app, ej. https://pase-de-lista.netlify.app
# Se usa en los QR de las tarjetas de activación. Si se deja vacío se usa
# la dirección desde donde se abre la app (en desarrollo sería localhost,
# que no abre desde el celular de los alumnos).
VITE_URL_PUBLICA=

# IMPORTANTE: la "service_role" key NUNCA va en este archivo ni en ninguna
# variable VITE_*, porque todo lo que empieza con VITE_ termina en el navegador.
# Esa llave solo se configura como secreto de las Edge Functions.
